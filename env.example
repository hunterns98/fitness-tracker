# ============================================
# Copy file này thành .env.local và điền vào
# ============================================

# Lấy ở: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Mật khẩu để đăng nhập vào app (tự đặt)
APP_PASSWORD=your-strong-password-here

# Dùng để ký cookie session (tối thiểu 32 ký tự, tự tạo bằng bất kỳ chuỗi random nào)
SESSION_SECRET=at-least-32-characters-random-string-here

# URL deploy (dùng cho redirect sau login)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
